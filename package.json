{
  "name": "diet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tipi && npm run verifica && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tipi": "quicktype dati.json --lang ts --just-types --top-level Dati --prefer-types --no-date-times --no-integer-strings --no-boolean-strings --no-combine-classes -o src/tipi/dati.generati.ts",
    "verifica": "node scripts/verifica-dati.ts",
    "prova-motore": "node scripts/prova-motore.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "quicktype": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
